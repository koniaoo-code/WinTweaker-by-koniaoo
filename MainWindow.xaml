<Window x:Class="WinTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTweaker - by koniaoo"
        Icon="icon.ico"
        Height="760" Width="1100" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Background="{DynamicResource BgDarkBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Material You M3 Card Template: Surface container with pill switch and typography -->
        <DataTemplate x:Key="TweakCardTemplate">
            <Border Style="{DynamicResource RowBorder}" Padding="16,10" Margin="0,3">
                <Grid MinHeight="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="4,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                   Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Desc}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{DynamicResource Switch}"
                                  Margin="10,0,4,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Click="OnToggleClick"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar: logo + navigation only (clean) ───────── -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardBorderBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,16,16,10">
                    <StackPanel x:Name="LogoBox" Orientation="Horizontal" Cursor="Hand"
                                Background="Transparent" MouseLeftButtonUp="OnLogoClick"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="Win" FontFamily="Segoe UI Black" FontSize="25" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Tweaker" FontFamily="Segoe UI Black" FontSize="25"
                                   Foreground="{DynamicResource OrangeBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ByLbl" Text="by koniaoo" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="2,3,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,3,0" Padding="0,0,2,0">
                    <StackPanel x:Name="NavPanel" Margin="10,2,6,10"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Right content ───────────────────────────────── -->
        <Grid Grid.Column="1" Background="{DynamicResource BgPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: big section title -->
            <Grid Grid.Row="0" Margin="30,22,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SecTitle" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="AdminDot" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/>
            </Grid>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Margin="22,2,18,4"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly" PreviewMouseWheel="OnContentWheel">
                <StackPanel x:Name="ContentHost"/>
            </ScrollViewer>

            <!-- Floating Modern Toast Notification (Snackbar) -->
            <Border x:Name="ToastNotification" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24" Background="#F0181B22" CornerRadius="20"
                    BorderThickness="1" BorderBrush="{DynamicResource OrangeBrush}"
                    Padding="18,9" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTranslate" Y="25"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="✓" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastText" Text="" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Log panel (collapsed by default; toggled from the bottom bar) -->
            <Border x:Name="LogPanel" Grid.Row="2" Background="#FF111114" Height="130"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}"
                    Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,6,16,0">
                        <TextBlock x:Name="LogLbl" Text="Лог" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ClearBtn" Content="Очистить" Style="{DynamicResource SmallButton}"
                                    Click="OnClearLog"/>
                            <Button Content="✕" Style="{DynamicResource SmallButton}" Width="24"
                                    Margin="6,0,0,0" Click="OnCloseLog"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogBox" Background="Transparent" Foreground="#FFAAAAB2"
                             FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Margin="16,4,16,8"
                             TextWrapping="NoWrap"/>
                </DockPanel>
            </Border>

            <!-- Bottom bar: search (left) + utilities (right) -->
            <Border Grid.Row="3" Background="{DynamicResource BgSidebarBrush}"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}">
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SearchHost" Grid.Column="0" Height="36"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="220" MaxWidth="240" MinWidth="130" Margin="0,0,10,0"
                            Background="{DynamicResource SearchBrush}" CornerRadius="18"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid>
                            <!-- Monochrome Fluent search glyph (matches the flat UI, no colored emoji) -->
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}" FontSize="12.5"
                                     VerticalContentAlignment="Center" Padding="34,0,28,0"
                                     TextChanged="OnSearch"/>
                            <Button x:Name="SearchClearBtn" Content="✕" Width="20" Height="20"
                                    Cursor="Hand" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,0,8,0"
                                    Style="{DynamicResource SmallButton}" Padding="0" Click="OnClearSearch"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RebootBtn" Style="{DynamicResource SmallButton}" Height="34"
                                Padding="11,0" Margin="0,0,6,0" Foreground="{DynamicResource OrangeBrush}"
                                Click="OnRebootClick" Visibility="Collapsed"/>
                        <Button x:Name="RestartExpBtn" Style="{DynamicResource SmallButton}" Height="34"
                                Padding="11,0" Margin="0,0,6,0" Click="OnRestartExplorer"/>
                        <Button x:Name="SettingsBtn" Style="{DynamicResource SmallButton}" Height="34"
                                Padding="11,0" Margin="0,0,6,0" Click="OnOpenAbout"/>
                        <Button x:Name="LogToggleBtn" Style="{DynamicResource SmallButton}" Height="34"
                                Padding="11,0" Click="OnToggleLog"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
