<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Google Material You (M3) Dynamic Pastel Palette ───────── -->
    <Color x:Key="Orange">#FFA8C7FA</Color>
    <Color x:Key="OrangeHover">#FFC2D9FC</Color>
    <SolidColorBrush x:Key="OrangeBrush"           Color="{DynamicResource Orange}"/>
    <SolidColorBrush x:Key="OrangeHoverBrush"      Color="{DynamicResource OrangeHover}"/>
    <SolidColorBrush x:Key="OnOrangeBrush"         Color="#FF003062"/>
    <SolidColorBrush x:Key="OrangeContainerBrush"   Color="#FF1E385B"/>
    <SolidColorBrush x:Key="OnOrangeContainerBrush" Color="#FFD3E3FD"/>

    <SolidColorBrush x:Key="BgDarkBrush"           Color="#FF101216"/>
    <SolidColorBrush x:Key="BgCardBrush"           Color="#FF1A1D23"/>
    <SolidColorBrush x:Key="BgCardHoverBrush"      Color="#FF232730"/>
    <SolidColorBrush x:Key="BgSidebarBrush"        Color="#FF15171C"/>
    <SolidColorBrush x:Key="BgPanelBrush"          Color="#FF121418"/>
    <SolidColorBrush x:Key="CardBorderBrush"       Color="#FF2B2F3A"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"      Color="#FFE3E2E6"/>
    <SolidColorBrush x:Key="SecBrush"              Color="#FFC4C6D0"/>
    <SolidColorBrush x:Key="MutedBrush"            Color="#FF8E919A"/>
    <SolidColorBrush x:Key="GreenBrush"            Color="#FF7ADA96"/>
    <SolidColorBrush x:Key="RedBrush"              Color="#FFF28B82"/>
    <SolidColorBrush x:Key="SwitchOffBrush"        Color="#FF1E2127"/>
    <SolidColorBrush x:Key="SwitchOffBorderBrush"  Color="#FF8C919D"/>
    <SolidColorBrush x:Key="SwitchOffThumbBrush"   Color="#FF938F99"/>
    <SolidColorBrush x:Key="SwitchOnThumbBrush"    Color="#FF003062"/>
    <SolidColorBrush x:Key="NavHoverBrush"         Color="#FF1E222A"/>
    <SolidColorBrush x:Key="NavActiveBrush"        Color="#FF263750"/>
    <SolidColorBrush x:Key="NavActiveTextBrush"    Color="#FFD3E3FD"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#408E919A"/>
    <SolidColorBrush x:Key="ChipBrush"             Color="#FF20242D"/>
    <SolidColorBrush x:Key="ChipHoverBrush"        Color="#FF2A303C"/>
    <SolidColorBrush x:Key="SearchBrush"           Color="#FF181A20"/>
    <SolidColorBrush x:Key="BtnSecondaryBrush"     Color="#FF242832"/>
    <SolidColorBrush x:Key="BtnSecondaryHoverBrush" Color="#FF2E3442"/>
    <SolidColorBrush x:Key="BtnSecondaryTextBrush" Color="#FFE3E2E6"/>

    <!-- Subtle Material You soft tonal gradient -->
    <LinearGradientBrush x:Key="OrangeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA8C7FA" Offset="0"/>
        <GradientStop Color="#FF90B6F8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrangeGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC2D9FC" Offset="0"/>
        <GradientStop Color="#FFA8C7FA" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Material You (M3) Animated Switch (16px → 24px) ──────── -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="16"
                            Background="{DynamicResource SwitchOffBrush}"
                            BorderThickness="2" BorderBrush="{DynamicResource SwitchOffBorderBrush}">
                        <Border x:Name="thumb" Width="16" Height="16" CornerRadius="12"
                                Background="{DynamicResource SwitchOffThumbBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="7,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="thumbT" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource OrangeBrush}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource SwitchOnThumbBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbT"
                                                         Storyboard.TargetProperty="X"
                                                         To="21" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="thumb"
                                                         Storyboard.TargetProperty="Width"
                                                         To="24" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="thumb"
                                                         Storyboard.TargetProperty="Height"
                                                         To="24" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ThicknessAnimation Storyboard.TargetName="thumb"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="4,0,0,0" Duration="0:0:0.20">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbT"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="thumb"
                                                         Storyboard.TargetProperty="Width"
                                                         To="16" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="thumb"
                                                         Storyboard.TargetProperty="Height"
                                                         To="16" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ThicknessAnimation Storyboard.TargetName="thumb"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="7,0,0,0" Duration="0:0:0.18">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Material You Surface Card (Tweak row) ──────────────── -->
    <Style x:Key="RowBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Margin" Value="0,3"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Material You Elevated Container ────────────────────── -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Material You Pill Primary Button ───────────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnOrangeBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource OrangeBrush}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OrangeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Material You Pill Nav Button (Sidebar) ─────────── -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SecBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Material You Small Pill Button ─────────────────── -->
    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource ChipBrush}" CornerRadius="17"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Material You Pill Flat/Action Button ───────────── -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnOrangeBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource OrangeBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.90"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Material You Secondary Tonal Button ────────────────── -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BtnSecondaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BtnSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnSecondaryHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Material You Metric Card (Dashboard tiles) ─────────── -->
    <Style x:Key="MetricCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Slim Modern ScrollBar ─────────────────────────── -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="th" CornerRadius="2.5" Background="{DynamicResource ScrollThumbBrush}" Margin="0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource OrangeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource SlimScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{DynamicResource SlimScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource SlimScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="5"/>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
